# Canonical origin. Until this is a real https URL, robots.txt blocks indexing.
NEXT_PUBLIC_SITE_URL=https://noratun.am

# Call-back delivery (/api/contact). Pick ONE; with neither, requests are
# validated, logged server-side, and the dialog honestly offers the phone.
RESEND_API_KEY=
CONTACT_TO=hello@noratun.am
CONTACT_FROM=Noratun site <hello@noratun.am>
CONTACT_WEBHOOK_URL=

# /admin — the homes editor. UNSET MEANS CLOSED: with no password the admin
# refuses everyone rather than defaulting to open.
ADMIN_PASSWORD=

# Where an admin save is written. In development it writes data/homes.json
# directly. In production a serverless filesystem would accept the write and
# lose it on the next deploy, so saves are committed to the repo instead and
# Vercel rebuilds. Without these two, production saves are REFUSED rather than
# silently dropped.
GITHUB_TOKEN=
GITHUB_REPO=yv993/noraTun-
GITHUB_BRANCH=main

# Analytics. Set ONE; with none set no script is shipped at all — not a
# disabled one. Plausible and Umami are cookieless and need no consent banner;
# GA4 sets cookies and does.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_GA_ID=

# Error alerts (/api/report). Client and server crashes are always written to
# the runtime log as `[noratun/error] {...}`; set this to also POST them to
# Slack, Discord, Make or Zapier. Unset simply means log-only.
ERROR_WEBHOOK_URL=
